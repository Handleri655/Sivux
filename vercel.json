{
  "redirects": [
    {
      "source": "/sivustoanalyysi.html",
      "destination": "/sivustoanalyysi",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/asiakas", "destination": "/asiakas/index.html" },
    { "source": "/asiakas/dashboard", "destination": "/asiakas/dashboard.html" },
    { "source": "/sivustoanalyysi", "destination": "/sivustoanalyysi.html" }
  ],
  "functions": {
    "api/audit.js": { "maxDuration": 30 },
    "api/audit-quote.js": { "maxDuration": 20 },
    "api/audit-generate.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formsubmit.co; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://va.vercel-scripts.com; connect-src 'self' https://vitals.vercel-insights.com https://va.vercel-scripts.com https://formsubmit.co;"
        }
      ]
    }
  ]
}
