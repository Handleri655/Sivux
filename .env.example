# Sivux client portal

# Shared auth secret for signed session tokens
AUTH_SECRET=replace-with-long-random-string

# Vercel API access (create at https://vercel.com/account/tokens)
VERCEL_TOKEN=vercel_xxx
# Optional if the project is under a team
VERCEL_TEAM_ID=team_xxx

# JK Best Carwash client
CLIENT_JK_EMAIL=jk@bestcarwash.fi
CLIENT_JK_PASSWORD=replace-with-strong-password
CLIENT_JK_NAME=JK Best Carwash
CLIENT_JK_DOMAIN=https://www.jk-bestcarwash.com
CLIENT_JK_PROJECT_ID=prj_xxx
# Optional override; falls back to VERCEL_TEAM_ID
CLIENT_JK_TEAM_ID=

# Lumia Autofix client
CLIENT_LUMIA_EMAIL=lumia@fixbest.fi
CLIENT_LUMIA_PASSWORD=replace-with-strong-password
CLIENT_LUMIA_NAME=Lumia Autofix
CLIENT_LUMIA_DOMAIN=https://www.fixbest.fi
CLIENT_LUMIA_PROJECT_ID=prj_xxx
CLIENT_LUMIA_TEAM_ID=
